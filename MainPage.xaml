<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:eBaySoldItemAnalyser.ViewModels"
    x:Class="eBaySoldItemAnalyser.MainPage">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Label 
            Text="eBay Sold Item Analyser"
            FontSize="24" />


        <Entry
            Placeholder="Search item..."
            Text="{Binding SearchTerm}" />


        <Picker
            Title="Select Marketplace"
            ItemsSource="{Binding MarketPlaces}"
            SelectedItem="{Binding SelectedMarketlace}"
            ItemDisplayBinding="{Binding Name}" />


        <Button
            Text="Search"
            Command="{Binding SearchCommand}" />


        <ActivityIndicator
            IsRunning="{Binding IsSearching}"
            IsVisible="{Binding IsSearching}" />

    </VerticalStackLayout>

</ContentPage>