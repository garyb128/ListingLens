<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ListingLens.MainPage"
    x:Name="MainPageRoot"
    Shell.NavBarIsVisible="False">

    <Grid
        Padding="16"
        RowSpacing="8">

        <Grid.RowDefinitions>

            <!-- Title -->
            <RowDefinition Height="Auto"/>

            <!-- Search -->
            <RowDefinition Height="Auto"/>

            <!-- Exclusions -->
            <RowDefinition Height="Auto"/>

            <!-- Marketplace / location / delivery -->
            <RowDefinition Height="Auto"/>

            <!-- Error -->
            <RowDefinition Height="Auto"/>

            <!-- Statistics -->
            <RowDefinition Height="Auto"/>

            <!-- Sort -->
            <RowDefinition Height="Auto"/>

            <!-- Results -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- =========================================================
             TITLE
             ========================================================= -->

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="8">

            <Grid ColumnDefinitions="*,Auto">

                <Label
                    Text="ListingLens"
                    FontSize="22"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    Margin="0,0,0,2" />

                <Button
                    Grid.Column="1"
                    Text="API keys"
                    Command="{Binding ToggleSettingsCommand}" />

            </Grid>

            <Border
                Padding="12"
                StrokeThickness="1"
                IsVisible="{Binding IsSettingsVisible}">

                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="eBay API keys"
                        FontAttributes="Bold" />

                    <Label
                        Text="ListingLens uses your own eBay developer keys (developer.ebay.com). They are stored on this device only."
                        FontSize="12"
                        Opacity="0.75" />

                    <Entry
                        Placeholder="Client ID (App ID)"
                        Text="{Binding ClientIdInput}" />

                    <Entry
                        Placeholder="Client Secret (Cert ID) - leave blank to keep the saved one"
                        IsPassword="True"
                        Text="{Binding ClientSecretInput}" />

                    <Picker
                        Title="Environment"
                        ItemsSource="{Binding Environments}"
                        SelectedItem="{Binding SelectedEnvironment}" />

                    <Label
                        Text="Use Production for real listings. Sandbox returns very little data."
                        FontSize="11"
                        Opacity="0.75" />

                    <HorizontalStackLayout Spacing="8">

                        <Button
                            Text="Save"
                            Command="{Binding SaveCredentialsCommand}" />

                        <Button
                            Text="Remove saved keys"
                            Command="{Binding ClearCredentialsCommand}"
                            IsVisible="{Binding HasSavedCredentials}" />

                    </HorizontalStackLayout>

                    <Label
                        Text="{Binding SettingsMessage}"
                        FontSize="12" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>


        <!-- =========================================================
             SEARCH
             ========================================================= -->

        <Grid
            Grid.Row="1"
            ColumnSpacing="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>


            <Entry
                Grid.Column="0"
                Placeholder="Search item..."
                Text="{Binding SearchTerm}" />


            <ActivityIndicator
                Grid.Column="1"
                IsRunning="{Binding IsSearching}"
                IsVisible="{Binding IsSearching}"
                VerticalOptions="Center"
                InputTransparent="True" />


            <Button
                Grid.Column="2"
                Text="Search"
                Command="{Binding SearchCommand}" />

        </Grid>


        <!-- =========================================================
             EXCLUSIONS
             ========================================================= -->

        <Entry
            Grid.Row="2"
            Placeholder="Exclude terms, separated by commas..."
            Text="{Binding ExcludeTerms}" />


        <!-- =========================================================
     FILTERS
     ========================================================= -->

        <Grid
    Grid.Row="3"
    ColumnSpacing="12"
    RowSpacing="3">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- LABELS -->

            <Label
        Grid.Row="0"
        Grid.Column="0"
        Text="Marketplace"
        FontSize="11"
        Opacity="0.75" />

            <Label
        Grid.Row="0"
        Grid.Column="1"
        Text="Item location"
        FontSize="11"
        Opacity="0.75" />

            <Label
        Grid.Row="0"
        Grid.Column="2"
        Text="Ships to"
        FontSize="11"
        Opacity="0.75" />


            <!-- PICKERS -->

            <Picker
        Grid.Row="1"
        Grid.Column="0"
        ItemsSource="{Binding MarketPlaces}"
        SelectedItem="{Binding SelectedMarketplace}"
        ItemDisplayBinding="{Binding Name}"
        HorizontalOptions="Fill" />

            <Picker
        Grid.Row="1"
        Grid.Column="1"
        ItemsSource="{Binding ItemLocationCountries}"
        SelectedItem="{Binding SelectedItemLocationCountry}"
        ItemDisplayBinding="{Binding Name}"
        HorizontalOptions="Fill" />

            <Picker
        Grid.Row="1"
        Grid.Column="2"
        ItemsSource="{Binding DeliveryCountries}"
        SelectedItem="{Binding SelectedDeliveryCountry}"
        ItemDisplayBinding="{Binding Name}"
        HorizontalOptions="Fill" />

        </Grid>


        <!-- =========================================================
             ERROR MESSAGE
             ========================================================= -->

        <Label
            Grid.Row="4"
            Text="{Binding ErrorMessage}"
            TextColor="Red"
            FontSize="13" />


        <!-- =========================================================
             MARKET SUMMARY
             ========================================================= -->

        <Border
            Grid.Row="5"
            Padding="12"
            StrokeThickness="1"
            IsVisible="{Binding HasStatistics}">

            <Grid
                RowSpacing="8">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- HEADER -->
                <Label
                    Grid.Row="0"
                    Text="Market Summary"
                    FontSize="17"
                    FontAttributes="Bold" />


                <!-- STATISTICS -->
                <Grid
                    Grid.Row="1"
                    ColumnSpacing="30">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- =====================
                         LOW
                         ===================== -->

                    <Grid
                        Grid.Column="0"
                        RowSpacing="4"
                        ColumnSpacing="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Lowest"
                            FontSize="11"
                            Opacity="0.7"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding Statistics.LowestDisplay}"
                            FontSize="16"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />


                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Typical Low"
                            FontSize="11"
                            Opacity="0.7"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Statistics.TypicalLowDisplay}"
                            FontSize="16"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                    </Grid>


                    <!-- =====================
                         CENTRE
                         ===================== -->

                    <Grid
                        Grid.Column="1"
                        RowSpacing="4"
                        ColumnSpacing="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Median"
                            FontSize="11"
                            Opacity="0.7"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding Statistics.MedianDisplay}"
                            FontSize="16"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />


                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Average"
                            FontSize="11"
                            Opacity="0.7"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Statistics.AverageDisplay}"
                            FontSize="16"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                    </Grid>


                    <!-- =====================
                         HIGH
                         ===================== -->

                    <Grid
                        Grid.Column="2"
                        RowSpacing="4"
                        ColumnSpacing="10">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Typical High"
                            FontSize="11"
                            Opacity="0.7"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding Statistics.TypicalHighDisplay}"
                            FontSize="16"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />


                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Highest"
                            FontSize="11"
                            Opacity="0.7"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Statistics.HighestDisplay}"
                            FontSize="16"
                            FontAttributes="Bold"
                            VerticalOptions="Center" />

                    </Grid>

                </Grid>

            </Grid>

        </Border>


        <!-- =========================================================
             SORT / RESULT COUNT
             ========================================================= -->

        <Grid
            Grid.Row="6"
            IsVisible="{Binding HasStatistics}"
            ColumnSpacing="8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <Label
                Grid.Column="0"
                Text="Sort:"
                VerticalOptions="Center"
                FontSize="12" />


            <Picker
                Grid.Column="1"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSortOption}"
                WidthRequest="190" />


            <Label
                Grid.Column="3"
                Text="{Binding Listings.Count,
                               StringFormat='{}{0} listings shown'}"
                FontSize="12"
                Opacity="0.65"
                VerticalOptions="Center" />

        </Grid>


        <!-- =========================================================
             LISTINGS
             ========================================================= -->

        <CollectionView
            Grid.Row="7"
            ItemsSource="{Binding Listings}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate>

                    <Border
                        Padding="12"
                        Margin="0,0,0,8"
                        StrokeThickness="1">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="7"/>
                        </Border.StrokeShape>


                        <!-- CLICK TO OPEN EBAY -->
                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding Source={x:Reference MainPageRoot},
                                                  Path=BindingContext.OpenListingCommand}"
                                CommandParameter="{Binding .}" />

                        </Border.GestureRecognizers>


                        <Grid
                            RowSpacing="8">

                            <Grid.RowDefinitions>

                                <!-- Title -->
                                <RowDefinition Height="Auto"/>

                                <!-- Listing information -->
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>


                            <!-- TITLE -->
                            <Label
                                Grid.Row="0"
                                Text="{Binding Title}"
                                FontSize="17"
                                FontAttributes="Bold"
                                MaxLines="2"
                                LineBreakMode="TailTruncation" />


                            <!-- CONTENT -->
                            <Grid
                                Grid.Row="1"
                                ColumnSpacing="15">

                                <Grid.ColumnDefinitions>

                                    <!-- Image -->
                                    <ColumnDefinition Width="100"/>

                                    <!-- Details -->
                                    <ColumnDefinition Width="*"/>

                                    <!-- Total -->
                                    <ColumnDefinition Width="150"/>

                                </Grid.ColumnDefinitions>


                                <!-- IMAGE -->
                                <Image
                                    Grid.Column="0"
                                    Source="{Binding ImageUrl}"
                                    HeightRequest="100"
                                    WidthRequest="100"
                                    Aspect="AspectFit" />


                                <!-- DETAILS -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalOptions="Center">

                                    <Label
                                        Text="{Binding ItemPriceDisplay}"
                                        FontSize="14" />

                                    <Label
                                        Text="{Binding ShippingPriceDisplay}"
                                        FontSize="14" />

                                    <Label
                                        Text="{Binding Condition}"
                                        FontSize="13"
                                        Opacity="0.85"
                                        Margin="0,5,0,0" />

                                    <Label
                                        Text="{Binding BuyingOption}"
                                        FontSize="12"
                                        Opacity="0.65" />

                                </VerticalStackLayout>


                                <!-- TOTAL -->
                                <VerticalStackLayout
                                    Grid.Column="2"
                                    Spacing="3"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End">

                                    <Label
                                        Text="Total"
                                        FontSize="11"
                                        Opacity="0.65"
                                        HorizontalTextAlignment="End" />

                                    <Label
                                        Text="{Binding TotalPriceDisplay}"
                                        FontSize="21"
                                        FontAttributes="Bold"
                                        HorizontalTextAlignment="End" />

                                    <Label
                                        Text="Item + P&amp;P"
                                        FontSize="10"
                                        Opacity="0.5"
                                        HorizontalTextAlignment="End" />

                                </VerticalStackLayout>

                            </Grid>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>